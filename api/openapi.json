{
  "openapi": "3.1.0",
  "info": {
    "title": "Factorio Agent Local API",
    "version": "0.1.0",
    "description": "Logic design, analysis and blueprint library. The game world uses the separate LAN SSH/RCON command interface."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8787"
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "health",
        "summary": "Read API version",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "version": {
                      "type": "string"
                    }
                  },
                  "required": ["version"]
                }
              }
            }
          },
          "default": {
            "description": "Error. Check error.code and error.message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/examples": {
      "get": {
        "operationId": "listExamples",
        "summary": "List bundled request and blueprint examples",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "examples": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "kind": {
                            "type": "string"
                          },
                          "path": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "name",
                          "kind",
                          "path"
                        ]
                      }
                    }
                  },
                  "required": ["examples"]
                }
              }
            }
          },
          "default": {
            "description": "Error. Check error.code and error.message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/designs": {
      "post": {
        "operationId": "designBlueprint",
        "summary": "Compile a Factorio blueprint, optionally with production and station analysis",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DesignResult"
                }
              }
            }
          },
          "default": {
            "description": "Error. Check error.code and error.message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DesignSpec"
              }
            }
          }
        }
      }
    },
    "/api/v1/production/analyze": {
      "post": {
        "operationId": "analyzeProduction",
        "summary": "Calculate steady-state production and material balances",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductionReport"
                }
              }
            }
          },
          "default": {
            "description": "Error. Check error.code and error.message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductionSpec"
              }
            }
          }
        }
      }
    },
    "/api/v1/logistics/analyze": {
      "post": {
        "operationId": "analyzeLogistics",
        "summary": "Calculate station, wagon and warehouse capacity",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogisticsReport"
                }
              }
            }
          },
          "default": {
            "description": "Error. Check error.code and error.message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogisticsSpec"
              }
            }
          }
        }
      }
    },
    "/api/v1/blueprints/decode": {
      "post": {
        "operationId": "decodeBlueprint",
        "summary": "Decode native data",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "document": {
                      "$ref": "#/components/schemas/BlueprintDocument"
                    }
                  },
                  "required": ["document"]
                }
              }
            }
          },
          "default": {
            "description": "Error. Check error.code and error.message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "blueprint": {
                    "$ref": "#/components/schemas/BlueprintInput"
                  }
                },
                "required": ["blueprint"]
              }
            }
          }
        }
      }
    },
    "/api/v1/blueprints/encode": {
      "post": {
        "operationId": "encodeBlueprint",
        "summary": "Encode native data",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "blueprint": {
                      "type": "string"
                    }
                  },
                  "required": ["blueprint"]
                }
              }
            }
          },
          "default": {
            "description": "Error. Check error.code and error.message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "document": {
                    "$ref": "#/components/schemas/BlueprintDocument"
                  }
                },
                "required": ["document"]
              }
            }
          }
        }
      }
    },
    "/api/v1/blueprints/inspect": {
      "post": {
        "operationId": "inspectBlueprint",
        "summary": "Decode and inspect an exchange string, book or planner",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "document": {
                      "$ref": "#/components/schemas/BlueprintDocument"
                    },
                    "inspection": {
                      "$ref": "#/components/schemas/Inspection"
                    }
                  },
                  "required": ["document", "inspection"]
                }
              }
            }
          },
          "default": {
            "description": "Error. Check error.code and error.message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "blueprint": {
                    "$ref": "#/components/schemas/BlueprintInput"
                  }
                },
                "required": ["blueprint"]
              }
            }
          }
        }
      }
    },
    "/api/v1/library": {
      "get": {
        "operationId": "listLibraryRevisions",
        "summary": "List blueprint library revisions",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "entries": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/LibrarySummary"
                      }
                    }
                  },
                  "required": ["entries"]
                }
              }
            }
          },
          "default": {
            "description": "Error. Check error.code and error.message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "key",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
            },
            "required": false
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 200
            },
            "required": false
          }
        ]
      },
      "post": {
        "operationId": "addLibraryRevision",
        "summary": "Store a reusable blueprint revision",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "entry": {
                      "$ref": "#/components/schemas/LibraryEntry"
                    }
                  },
                  "required": ["entry"]
                }
              }
            }
          },
          "default": {
            "description": "Error. Check error.code and error.message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LibraryAdd"
              }
            }
          }
        }
      }
    },
    "/api/v1/library/{id}": {
      "get": {
        "operationId": "getLibraryRevision",
        "summary": "Get a blueprint revision and its exchange string",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "entry": {
                      "$ref": "#/components/schemas/LibraryEntry"
                    }
                  },
                  "required": ["entry"]
                }
              }
            }
          },
          "default": {
            "description": "Error. Check error.code and error.message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "required": true
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": ["code", "message"]
          }
        },
        "required": ["error"]
      },
      "BlueprintDocument": {
        "description": "Native Factorio blueprint/book/planner wrapper. Native fields preserved.",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "blueprint": {
                "type": "object"
              }
            },
            "required": ["blueprint"]
          },
          {
            "type": "object",
            "properties": {
              "blueprint_book": {
                "type": "object"
              }
            },
            "required": ["blueprint_book"]
          },
          {
            "type": "object",
            "properties": {
              "deconstruction_planner": {
                "type": "object"
              }
            },
            "required": ["deconstruction_planner"]
          },
          {
            "type": "object",
            "properties": {
              "upgrade_planner": {
                "type": "object"
              }
            },
            "required": ["upgrade_planner"]
          }
        ]
      },
      "BlueprintInput": {
        "oneOf": [
          {
            "type": "string",
            "description": "Game exchange string starting with 0, or one native JSON wrapper as text."
          },
          {
            "$ref": "#/components/schemas/BlueprintDocument"
          }
        ]
      },
      "Inspection": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "prototypeVersion": {
            "type": "integer"
          },
          "entityCount": {
            "type": "integer"
          },
          "tileCount": {
            "type": "integer"
          },
          "wireCount": {
            "type": "integer"
          },
          "stations": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "entityCenterBounds": {
            "type": "object"
          },
          "prototypes": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "recipes": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          }
        },
        "required": ["type"]
      },
      "ProductionSpec": {
        "type": "object",
        "properties": {
          "targets": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            }
          },
          "external": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "processes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "recipe": {
                  "type": "string"
                },
                "machine": {
                  "type": "string"
                },
                "seconds": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "speed": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "count": {
                  "type": "integer",
                  "minimum": 0
                },
                "runsPerMinute": {
                  "type": "number",
                  "minimum": 0
                },
                "ingredients": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "products": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              },
              "required": [
                "recipe",
                "seconds",
                "speed",
                "products"
              ]
            },
            "minItems": 1
          }
        },
        "required": ["processes"]
      },
      "ProductionReport": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": ["targets", "explicit"]
          },
          "feasible": {
            "type": "boolean"
          },
          "targets": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            }
          },
          "targetShortfalls": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            }
          },
          "imports": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            }
          },
          "outputs": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            }
          },
          "surplus": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            }
          },
          "processes": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "balance": {
            "type": "object",
            "additionalProperties": {
              "type": "object"
            }
          }
        },
        "required": [
          "mode",
          "feasible",
          "processes",
          "imports",
          "outputs"
        ]
      },
      "LogisticsSpec": {
        "type": "object",
        "properties": {
          "module": {
            "type": "string"
          },
          "stations": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "sequence": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 99
                    },
                    "label": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "berths": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "usableTrackTiles": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "role": {
                      "type": "string",
                      "const": "queue"
                    },
                    "serves": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 99
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    }
                  },
                  "required": [
                    "sequence",
                    "role",
                    "serves"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "sequence": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 99
                    },
                    "label": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "berths": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "usableTrackTiles": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "role": {
                      "type": "string",
                      "enum": ["input", "output"]
                    },
                    "train": {
                      "type": "object",
                      "properties": {
                        "locomotives": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "wagons": {
                          "type": "array",
                          "items": {
                            "oneOf": [
                              {
                                "type": "object",
                                "properties": {
                                  "type": {
                                    "type": "string",
                                    "const": "cargo"
                                  },
                                  "capacity": {
                                    "type": "number",
                                    "exclusiveMinimum": 0
                                  },
                                  "materials": {
                                    "type": "object",
                                    "additionalProperties": {
                                      "type": "object",
                                      "properties": {
                                        "slots": {
                                          "type": "integer",
                                          "minimum": 1
                                        },
                                        "stackSize": {
                                          "type": "integer",
                                          "minimum": 1
                                        }
                                      },
                                      "required": ["slots", "stackSize"]
                                    }
                                  }
                                },
                                "required": [
                                  "type",
                                  "capacity",
                                  "materials"
                                ]
                              },
                              {
                                "type": "object",
                                "properties": {
                                  "type": {
                                    "type": "string",
                                    "const": "fluid"
                                  },
                                  "capacity": {
                                    "type": "number",
                                    "exclusiveMinimum": 0
                                  },
                                  "materials": {
                                    "type": "object",
                                    "additionalProperties": {
                                      "type": "number",
                                      "exclusiveMinimum": 0
                                    }
                                  }
                                },
                                "required": [
                                  "type",
                                  "capacity",
                                  "materials"
                                ]
                              }
                            ]
                          },
                          "minItems": 1
                        },
                        "requiredTrackTiles": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        }
                      },
                      "required": ["locomotives", "wagons"]
                    },
                    "buffers": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "capacity": {
                            "type": "number",
                            "minimum": 0
                          },
                          "ratePerMinute": {
                            "type": "number",
                            "minimum": 0
                          },
                          "reserveMinutes": {
                            "type": "number",
                            "minimum": 0
                          },
                          "batch": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          }
                        },
                        "required": ["capacity", "ratePerMinute"]
                      }
                    }
                  },
                  "required": [
                    "sequence",
                    "role",
                    "train",
                    "buffers"
                  ]
                }
              ]
            },
            "minItems": 1
          }
        },
        "required": ["module", "stations"]
      },
      "LogisticsReport": {
        "type": "object",
        "properties": {
          "module": {
            "type": "string"
          },
          "stations": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "shortfalls": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "module",
          "stations",
          "shortfalls"
        ]
      },
      "DesignSpec": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "icons": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "metadata": {
            "type": "object"
          },
          "entities": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "entity_number": {
                  "type": "integer",
                  "minimum": 1
                },
                "name": {
                  "type": "string"
                },
                "position": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    }
                  },
                  "required": ["x", "y"]
                },
                "direction": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 15
                }
              },
              "required": ["name", "position"]
            }
          },
          "tiles": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "position": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "integer"
                    },
                    "y": {
                      "type": "integer"
                    }
                  },
                  "required": ["x", "y"]
                }
              },
              "required": ["name", "position"]
            }
          },
          "wires": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "minItems": 4,
              "maxItems": 4
            }
          },
          "schedules": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "stock_connections": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "source": {
                  "$ref": "#/components/schemas/BlueprintInput"
                },
                "offset": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "integer"
                    },
                    "y": {
                      "type": "integer"
                    }
